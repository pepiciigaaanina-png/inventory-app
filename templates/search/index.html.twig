<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Моето Имущество</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .table input.form-control {
            max-width: 90px;
            display: inline-block;
            text-align: center;
        }
        .table input.unit-input {
            max-width: 75px;
            text-align: center;
        }
        .table input.price-input {
            text-align: right;
            max-width: 100px;
        }
    </style>
</head>
<body class="bg-light">
<div class="container mt-4 mb-5">
    <h2 class="mb-4 text-center fw-bold text-secondary">Търсачка на имущество</h2>

    <div class="mb-4 d-flex gap-2">
        <div class="input-group shadow-sm flex-grow-1">
            <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="Въведи име или код..." autocomplete="off">
        </div>

        <button class="btn btn-secondary shadow-sm px-4 fw-semibold" onclick="document.getElementById('cameraInput').click()">
            📷 Снимай
        </button>
        <input type="file" id="cameraInput" accept="image/*" capture="environment" class="d-none">
    </div>

    <div class="table-responsive shadow-sm rounded bg-white p-2">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
            <tr>
                <th style="width: 18%;" class="py-3 ps-3">Код</th>
                <th style="width: 36%;" class="py-3">Име на артикула</th>
                <th style="width: 16%;" class="text-center py-3">Брой <span id="totalQtyHeader" class="fw-normal text-warning"></span></th>
                <th style="width: 14%;" class="text-center py-3">М.ед.</th>
                <th style="width: 16%;" class="text-end py-3 pe-4">Цена (лв.) <span id="totalPriceHeader" class="fw-normal text-warning"></span></th>
            </tr>
            </thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>

<!-- Modal за списъка с разпознати артикули от снимката -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Разпознати артикули от протокола</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="table-light sticky-top">
                        <tr>
                            <th style="width: 5%;" class="text-center">✓</th>
                            <th>Код</th>
                            <th>Име (от снимката)</th>
                            <th class="text-center">Мярка</th>
                            <th class="text-center">Колич.</th>
                            <th class="text-center">Статус в БД</th>
                            <th class="text-center">Склад</th>
                        </tr>
                        </thead>
                        <tbody id="modalTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between bg-light">
                <span id="scanStatusText" class="text-muted fw-semibold"></span>
                <div>
                    <button type="button" class="btn btn-danger px-4 fw-semibold" onclick="submitBatchInventory('remove')">Изпиши активните</button>
                    <button type="button" class="btn btn-success px-4 fw-semibold" onclick="submitBatchInventory('add')">Заприходи активните</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const tableBody = document.getElementById('tableBody');
    const cameraInput = document.getElementById('cameraInput');
    const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));

    let typingTimer;
    let scannedItemsData = [];

    async function fetchItems(query = '') {
        const response = await fetch(`/search?q=${encodeURIComponent(query)}`, { headers: { 'Accept': 'application/json' } });
        const items = await response.json();
        tableBody.innerHTML = '';

        if (items.length === 0) {
            tableBody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">Няма намерени артикули.</td></tr>`;
            document.getElementById('totalQtyHeader').textContent = '(общо: 0)';
            document.getElementById('totalPriceHeader').textContent = '(общо: 0.00 лв.)';
            return;
        }

        let sumQty = 0;
        let sumPrice = 0;

        items.forEach(item => {
            const qty = parseFloat(item.quantity) || 0;
            const unitPrice = parseFloat(item.price) || 0;
            const totalRowPrice = qty * unitPrice;

            sumQty += qty;
            sumPrice += totalRowPrice;

            tableBody.innerHTML += `<tr id="row-${item.id}">
                <td class="text-muted fw-semibold ps-3">${item.code || '-'}</td>
                <td class="fw-medium">${item.name}</td>
                <td class="text-center">
                    <div class="input-group input-group-sm justify-content-center">
                        <input type="number" step="any" id="qty-${item.id}" class="form-control form-control-sm text-center item-qty" data-id="${item.id}" value="${qty}"
                               disabled
                               style="background-color: #e9ecef;"
                               oninput="multiplyRowPrice(${item.id})">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="edit-qty-btn-${item.id}" onclick="toggleMainRowEdit(${item.id}, 'qty')">✏️</button>
                    </div>
                </td>
                <td class="text-center">
                    <div class="input-group input-group-sm justify-content-center">
                        <input type="text" id="unit-${item.id}" class="form-control form-control-sm unit-input" value="${item.unit || 'бр.'}"
                               disabled
                               style="background-color: #e9ecef;">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="edit-unit-btn-${item.id}" onclick="toggleMainRowEdit(${item.id}, 'unit')">✏️</button>
                    </div>
                </td>
                <td class="text-end pe-3">
                    <div class="input-group input-group-sm justify-content-end">
                        <input type="number" step="any" id="price-${item.id}" class="form-control form-control-sm price-input item-price" data-id="${item.id}" data-unit-price="${unitPrice}" value="${totalRowPrice.toFixed(2)}"
                               disabled
                               style="background-color: #e9ecef;"
                               oninput="updateGrandTotals()">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="edit-price-btn-${item.id}" onclick="toggleMainRowEdit(${item.id}, 'price')">✏️</button>
                        <span class="input-group-text bg-light text-muted">лв.</span>
                    </div>
                </td>
            </tr>`;
        });

        document.getElementById('totalQtyHeader').textContent = `(общо: ${sumQty.toFixed(2)})`;
        document.getElementById('totalPriceHeader').textContent = `(общо: ${sumPrice.toFixed(2)} лв.)`;
    }

    // Умножава новия брой по единичната цена и обновява цената на реда на живо
    function multiplyRowPrice(id) {
        const qtyInput = document.getElementById(`qty-${id}`);
        const priceInput = document.getElementById(`price-${id}`);

        if (qtyInput && priceInput) {
            const qty = parseFloat(qtyInput.value) || 0;
            const unitPrice = parseFloat(priceInput.getAttribute('data-unit-price')) || 0;

            const newTotalRowPrice = qty * unitPrice;
            priceInput.value = newTotalRowPrice.toFixed(2);
        }

        updateGrandTotals();
    }

    // Динамично пресмятане на общите суми горе в заглавието на таблицата
    function updateGrandTotals() {
        let totalQty = 0;
        let totalPrice = 0;

        document.querySelectorAll('.item-qty').forEach(input => {
            const id = input.getAttribute('data-id');
            const priceInput = document.getElementById(`price-${id}`);
            const qty = parseFloat(input.value) || 0;
            const price = priceInput ? (parseFloat(priceInput.value) || 0) : 0;

            totalQty += qty;
            totalPrice += price;
        });

        document.getElementById('totalQtyHeader').textContent = `(общо: ${totalQty.toFixed(2)})`;
        document.getElementById('totalPriceHeader').textContent = `(общо: ${totalPrice.toFixed(2)} лв.)`;
    }

    async function toggleMainRowEdit(id, field) {
        const dbField = (field === 'qty') ? 'quantity' : field;
        const input = document.getElementById(`${field}-${id}`);
        const btn = document.getElementById(`edit-${field}-btn-${id}`);

        if (input.disabled) {
            input.disabled = false;
            input.style.backgroundColor = '#ffffff';
            input.focus();
            btn.innerHTML = '💾';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
        } else {
            let val = input.value;
            if (field === 'qty') {
                val = parseFloat(val) || 0;
                if (val <= 0) {
                    if (!confirm('Количеството е 0. Искате ли този артикул да бъде изтрит от базата?')) {
                        input.focus();
                        return;
                    }
                }
            }

            input.disabled = true;
            input.style.backgroundColor = '#e9ecef';
            btn.innerHTML = '✏️';
            btn.classList.remove('btn-success');
            btn.classList.add('btn-outline-secondary');

            await updateItemField(id, dbField, val);
            fetchItems(searchInput.value.trim());
        }
    }

    async function updateItemField(id, field, value) {
        try {
            const response = await fetch('/api/update-item-inline', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, field: field, value: value })
            });
            const result = await response.json();
            if (!result.success) {
                alert('Грешка при обновяване!');
            }
        } catch (error) {
            alert('Грешка при връзка със сървъра!');
        }
    }

    searchInput.addEventListener('input', () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => fetchItems(searchInput.value.trim()), 150);
    });
    fetchItems('');

    // --- Камера и Модална таблица ---
    cameraInput.addEventListener('change', async (e) => {
        if (e.target.files.length === 0) return;

        const file = e.target.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('image', file);

        try {
            const response = await fetch('/api/analyze-image', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();
            if (data.error) {
                alert(data.error);
                return;
            }

            scannedItemsData = data.items || [];
            const modalTableBody = document.getElementById('modalTableBody');
            modalTableBody.innerHTML = '';

            if (scannedItemsData.length === 0) {
                modalTableBody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">Няма намерени редове.</td></tr>`;
            } else {
                scannedItemsData.forEach((item, index) => {
                    const badgeColor = item.exists_in_db ? 'bg-success' : 'bg-danger';
                    const statusText = item.exists_in_db ? 'Наличен' : 'Липсва в БД';

                    modalTableBody.innerHTML += `
                        <tr id="modal-row-${index}">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input modal-checkbox" data-index="${index}" checked>
                            </td>
                            <td><small class="text-muted">${item.code}</small></td>
                            <td>${item.scanned_name}</td>

                            <td class="text-center">
                                <input type="text" id="modal-unit-${index}"
                                       class="form-control form-control-sm text-center mx-auto"
                                       value="${item.scanned_unit}"
                                       oninput="scannedItemsData[${index}].scanned_unit = this.value"
                                       style="max-width: 60px;">
                            </td>

                            <td class="text-center">
                                <input type="number" step="any" id="modal-qty-${index}"
                                       class="form-control form-control-sm text-center mx-auto"
                                       value="${item.scanned_quantity}"
                                       oninput="scannedItemsData[${index}].scanned_quantity = parseFloat(this.value) || 0"
                                       style="max-width: 90px;">
                            </td>
                            <td class="text-center"><span class="badge ${badgeColor}">${statusText}</span></td>
                            <td class="text-center">${item.current_stock}</td>
                        </tr>
                    `;
                });
            }

            document.getElementById('scanStatusText').textContent = `Общо разпознати: ${scannedItemsData.length} реда`;
            confirmModal.show();
        } catch (error) {
            alert('Грешка при разпознаване на снимката!');
        }

        cameraInput.value = '';
    });

    async function submitBatchInventory(action) {
        const checkboxes = document.querySelectorAll('#modalTableBody input.modal-checkbox:checked');
        let selectedItems = [];

        checkboxes.forEach(cb => {
            const index = cb.getAttribute('data-index');
            if (scannedItemsData[index]) {
                selectedItems.push({
                    code: scannedItemsData[index].code,
                    scanned_name: scannedItemsData[index].scanned_name,
                    scanned_quantity: scannedItemsData[index].scanned_quantity,
                    scanned_unit: scannedItemsData[index].scanned_unit || 'бр.'
                });
            }
        });

        if (selectedItems.length === 0) {
            alert('Моля, изберете поне един артикул!');
            return;
        }

        try {
            const response = await fetch('/api/update-inventory-batch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action, items: selectedItems })
            });

            const textResult = await response.text();
            let result;
            try {
                result = JSON.parse(textResult);
            } catch (e) {
                alert("Фатална грешка в сървъра (виж конзолата - F12)");
                return;
            }

            if (result.success) {
                confirmModal.hide();
                fetchItems(searchInput.value.trim());
                alert(result.message);
            } else {
                alert(result.error || 'Възникна грешка.');
            }
        } catch (error) {
            alert('Грешка при връзка със сървъра!');
        }
    }
</script>
</body>
</html>
